<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WebViewDriver.Selenium.AppiumMac</RootNamespace>
    <Description>Trusted-input Actions backend for WebViewDriver: routes W3C Actions through an Appium mac2 session as real OS input (CSS :hover, HTML5 drag-and-drop, canvas drags) at screen coordinates computed from the webview's accessibility frame. Optional companion to WebViewDriver.Selenium.</Description>
    <PackageTags>webdriver;selenium;appium;mac2;wkwebview;maui;maccatalyst;testing;automation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WebViewDriver.Selenium/WebViewDriver.Selenium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebViewDriver.Tests" />
  </ItemGroup>

</Project>
